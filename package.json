{
  "name": "forkin",
  "private": true,
  "bin": {
    "forkin": "./dist/cli/forkin.mjs"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vp dev --port 3000",
    "build": "vp build",
    "preview": "vp build && vp preview",
    "deploy": "vp build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint",
    "check": "vp check && tsc --noEmit -p .",
    "cli": "vp pack"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@cloudflare/sandbox": "1.0.1",
    "@effect/platform-node": "4.0.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@modelcontextprotocol/server": "2.3.1",
    "@pierre/diffs": "^1.5.2",
    "@pierre/trees": "1.0.0-beta.6",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.2",
    "agents": "^0.28.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "effect": "4.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@effect/tsgo": "0.53.0",
    "@effect/vitest": "^4.0.4",
    "@oxlint/plugins": "1.88.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.151.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  }
}
